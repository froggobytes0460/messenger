#include <client/constants.h>
#include <client/log.h>
#include <stdarg.h>
#include <stdio.h>

static FILE* log_file = NULL;

void open_log_file(const char* filename) {
  log_file = fopen(filename, "a");
  if (log_file == NULL) {
    perror("Error opening log file");
    return;
  }
}

void close_log_file() {
  if (log_file == NULL) {
    return;
  }
  int rc = fclose(log_file);
  if (rc != 0) {
    perror("Error closing log file");
  }
}

int log_write(log_level_t level, const char* tag, const char* fmt, ...) {
  char log_msg[MAX_LOG_MSG_LEN + 1];
  va_list args;
  va_start(args, fmt);
  (void)vsnprintf(log_msg, sizeof(log_msg), fmt, args);
  va_end(args);
  return 0;
}
